# Secrets and environment files
.env
.env.*
!.env.example
*.pem
*.key
secrets/
.secrets/

# Local overrides that must never be committed
*-extra.yml
*.auto.tfvars
!*.auto.tfvars.example

# Runtime data and logs
data/
*.log

# OpenTofu and Ansible
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
*.tfplan
crash.log
override.tf
override.tf.json
*.retry
.ansible/
**/.terraform-validate/
